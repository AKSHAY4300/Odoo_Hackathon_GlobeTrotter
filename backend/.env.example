# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Leave empty to automatically use built-in embedded in-memory MongoDB runner,
# or point to your local/cloud MongoDB: mongodb://localhost:27017/globetrotter
MONGODB_URI=

# JWT Authentication
JWT_SECRET=globetrotter_jwt_secret_dev_key_2026_super_secure_token
JWT_EXPIRES_IN=7d

# CORS Client Origin
CLIENT_ORIGIN=http://localhost:5173
